# Copy to .env (not versioned) or set in the deployment environment. Placeholders only.
PORT=3100
HOST=0.0.0.0
DATABASE_PATH=./data/company-pulse.sqlite
LOG_LEVEL=info              # debug | info | warn | error | silent
TRUST_PROXY=0               # proxy hops to trust for X-Forwarded-For (1 behind one reverse proxy)
RATE_LIMIT_PER_MINUTE=60    # API writes per IP per minute; 0 disables
AGENT_RUNS_PER_MINUTE=12    # agent runs per IP per minute; 0 disables
SESSION_SECRET=             # >= 32 random chars; empty = random per boot (sessions reset on restart)
COOKIE_SECURE=              # default: 1 when NODE_ENV=production
DEMO_DEFAULT_PERSONA=elena  # persona for requests without a session; empty requires choosing one
PUBLIC_ORIGIN=              # e.g. https://pulse.example.com; when set, writes must come from it exactly
SEED_DEMO=1                 # seed the fictional company and run agents on first boot
